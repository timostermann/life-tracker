{
	"name": "life-tracker",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">= 24",
		"npm": ">= 11"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --write . && eslint . && npm run check",
		"commitlint": "commitlint --edit",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"release": "commit-and-tag-version",
		"release:test": "commit-and-tag-version --skip.commit --skip.tag",
		"db:seed": "vite-node src/lib/server/db/seeds/run.ts",
		"db:clean": "vite-node src/lib/server/db/seeds/run.ts -- --clean-test-data --skip-if-exists",
		"generate:icons": "node scripts/generate-icons.js"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.3.0",
		"@commitlint/config-conventional": "^20.3.0",
		"@commitlint/types": "^20.2.0",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@internationalized/date": "^3.10.1",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.1",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24.10.4",
		"@vitest/browser-playwright": "^4.0.15",
		"@vitest/coverage-v8": "^4.0.16",
		"bits-ui": "^2.15.4",
		"commit-and-tag-version": "^12.6.1",
		"commitlint-plugin-function-rules": "^4.2.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"playwright": "^1.57.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.1.0",
		"sharp": "^0.34.5",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"svelte-sonner": "^1.0.7",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vite-node": "^5.2.0",
		"vitest": "^4.0.15",
		"vitest-browser-svelte": "^2.0.1",
		"zod": "^4.3.4"
	},
	"dependencies": {
		"@lucia-auth/adapter-postgresql": "^3.1.2",
		"@sentry/sveltekit": "^10.51.0",
		"clsx": "^2.1.1",
		"lucia": "^3.2.2",
		"lucide-svelte": "^0.562.0",
		"postgres": "^3.4.9",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2"
	}
}
